# ═══════════════════════════════════════════════════════════════════════
# RAG Empresarial - Variables de Entorno
# ═══════════════════════════════════════════════════════════════════════
# Copia este archivo como .env y ajusta los valores según tu entorno.
#   cp .env.example .env

# ─── Proveedor LLM ────────────────────────────────────────────────────
# Opciones: "ollama" (local, gratuito) | "openai" (requiere API key)
LLM_PROVIDER=ollama

# ─── Ollama (modelo local) ────────────────────────────────────────────
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3

# ─── OpenAI (opcional) ────────────────────────────────────────────────
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-3.5-turbo

# ─── Modelo de Embeddings ─────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ─── Parámetros de Chunking ───────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ─── Parámetros de Búsqueda y Generación ──────────────────────────────
TOP_K=5
TEMPERATURE=0.3

# ─── n8n ───────────────────────────────────────────────────────────────
N8N_USER=admin
N8N_PASSWORD=admin123

# ─── JWT (Autenticación) ──────────────────────────────────────────────
JWT_SECRET_KEY=rag-empresarial-secret-key-cambiar-en-produccion-2024
JWT_EXPIRE_MINUTES=480
